.env
.DS_Store

# Agent worktrees
.claude/worktrees/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# marimo session cache
__marimo__/

# lab outputs derived from the dataset or from LLM calls: never versioned
lab/.cache/
lab/profiling/out/

# JavaScript
node_modules/
dist/
.turbo/
# Generated, but committed on purpose: apps and CI need no build step.
# `make design-tokens-check` fails when it drifts from src/.
!packages/design-tokens/dist/

# The organization's dataset is not versioned
data/raw/*
data/staging/*
data/curated/*
data/eval/*
!data/eval/synthetic/
!data/eval/synthetic/**
!data/**/.gitkeep
!data/raw/README.md

# Model weights
packages/encoder/weights/
packages/retrieval/weights/
*.safetensors
*.onnx

# Evaluation reports ARE versioned: they are the evidence
!reports/*.md

# Terraform (infra/deploy/gcp): working dirs, state and plans. The lock file is committed.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan

# Terraform: per-person inputs (project, repository, IAP accounts); local.tfvars.example lists them.
infra/deploy/gcp/local.tfvars

# OAuth client files downloaded from the GCP console (gcp-iap-oauth reads the values by hand).
client_secret_*.json

# llmbench run files: per-machine, per-day; a comparison worth keeping goes to reports/ via --publish
tools/llmbench/results/
