.env
.DS_Store

# Agent worktrees
.claude/worktrees/

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# marimo session cache
__marimo__/

# lab outputs derived from the dataset or from LLM calls: never versioned
lab/.cache/
lab/profiling/out/

# JavaScript
node_modules/
dist/
.turbo/
# Generated, but committed on purpose: apps and CI need no build step.
# `make design-tokens-check` fails when it drifts from src/.
!packages/design-tokens/dist/

# The organization's dataset is not versioned
data/raw/*
data/staging/*
data/curated/*
data/eval/*
!data/eval/synthetic/
!data/eval/synthetic/**
!data/**/.gitkeep
!data/raw/README.md

# Model weights
packages/encoder/weights/
packages/retrieval/weights/
*.safetensors
*.onnx

# Evaluation reports ARE versioned: they are the evidence
!reports/*.md
