{
  "$defs": {
    "Receipt": {
      "additionalProperties": false,
      "description": "Database-verified receipt returned on state-mutating actions.",
      "properties": {
        "action": {
          "description": "Action executed (e.g. card.block)",
          "maxLength": 64,
          "minLength": 3,
          "title": "Action",
          "type": "string"
        },
        "audit_id": {
          "description": "Cryptographic/audit reference ID",
          "maxLength": 128,
          "minLength": 8,
          "title": "Audit Id",
          "type": "string"
        },
        "state_after": {
          "$ref": "#/$defs/ResourceState",
          "description": "Resource state following action execution"
        },
        "state_before": {
          "$ref": "#/$defs/ResourceState",
          "description": "Resource state prior to action execution"
        },
        "target_masked": {
          "description": "Masked target identifier adhering to allowlist: masked PAN, email, phone, or opaque ref",
          "maxLength": 64,
          "minLength": 6,
          "pattern": "^((\\*{4}[\\s-]?\\*{4}[\\s-]?\\*{4}[\\s-]?\\d{4}|\\*{4,12}\\d{4})|[a-zA-Z0-9]\\*+@[a-zA-Z0-9.-]+\\.[a-zA-Z]{2,}|(\\+?\\d{1,3}[-\\s]?)?(\\d{1,4}[-\\s]?)?(\\*+[-\\s]?)+\\d{2,4}|(card|hnd|otp|chal|ticket|handoff)[_-][A-Za-z0-9*_-]{6,50})$",
          "title": "Target Masked",
          "type": "string"
        },
        "verified_at": {
          "description": "Timestamp of verified execution in database",
          "format": "date-time",
          "title": "Verified At",
          "type": "string"
        }
      },
      "required": [
        "action",
        "target_masked",
        "state_before",
        "state_after",
        "verified_at",
        "audit_id"
      ],
      "title": "Receipt",
      "type": "object"
    },
    "ReceiptBlock": {
      "additionalProperties": false,
      "description": "Verified receipt of a state-mutating action, re-read from the database.",
      "properties": {
        "receipt": {
          "$ref": "#/$defs/Receipt",
          "description": "Receipt returned by banking-core"
        },
        "type": {
          "const": "receipt",
          "default": "receipt",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "receipt"
      ],
      "title": "ReceiptBlock",
      "type": "object"
    },
    "ResourceState": {
      "description": "Resource state prior to and following execution of a state-mutating tool.",
      "enum": [
        "NONE",
        "ACTIVE",
        "BLOCKED",
        "FROZEN",
        "ISSUED",
        "PENDING",
        "VERIFIED",
        "EXPIRED",
        "LOCKED",
        "QUEUED",
        "ASSIGNED",
        "RESOLVED",
        "ANONYMOUS",
        "IDENTIFIED",
        "OTP_PENDING",
        "HANDED_OFF"
      ],
      "title": "ResourceState",
      "type": "string"
    },
    "TextBlock": {
      "additionalProperties": false,
      "description": "Plain assistant text.",
      "properties": {
        "text": {
          "description": "Assistant text shown to the customer",
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "text",
          "default": "text",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "TextBlock",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "receipt": "#/$defs/ReceiptBlock",
      "text": "#/$defs/TextBlock"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/TextBlock"
    },
    {
      "$ref": "#/$defs/ReceiptBlock"
    }
  ]
}
