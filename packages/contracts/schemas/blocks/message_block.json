{
  "$defs": {
    "Department": {
      "description": "Bank back-office specialized queues.",
      "enum": [
        "FRAUD_OPERATIONS",
        "CUSTOMER_SUPPORT",
        "DISPUTES"
      ],
      "title": "Department",
      "type": "string"
    },
    "HandoffBlock": {
      "additionalProperties": false,
      "description": "Engine-built handoff details backed by a banking-core ToolResult receipt.",
      "properties": {
        "department": {
          "$ref": "#/$defs/Department"
        },
        "handoff_id": {
          "maxLength": 64,
          "minLength": 8,
          "title": "Handoff Id",
          "type": "string"
        },
        "priority": {
          "$ref": "#/$defs/HandoffPriority"
        },
        "queue_position": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Queue Position"
        },
        "receipt": {
          "$ref": "#/$defs/Receipt",
          "description": "Verified handoff creation receipt"
        },
        "status": {
          "$ref": "#/$defs/HandoffStatus"
        },
        "summary": {
          "$ref": "#/$defs/HandoffSummary"
        },
        "type": {
          "const": "handoff",
          "default": "handoff",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "handoff_id",
        "status",
        "department",
        "priority",
        "summary",
        "receipt"
      ],
      "title": "HandoffBlock",
      "type": "object"
    },
    "HandoffOpenQuestion": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "source",
        "text"
      ],
      "title": "HandoffOpenQuestion",
      "type": "object"
    },
    "HandoffPriority": {
      "description": "Queue priority for agent assignment.",
      "enum": [
        "LOW",
        "NORMAL",
        "HIGH",
        "URGENT"
      ],
      "title": "HandoffPriority",
      "type": "string"
    },
    "HandoffStatus": {
      "description": "Status of handoff ticket.",
      "enum": [
        "QUEUED",
        "ASSIGNED",
        "PENDING"
      ],
      "title": "HandoffStatus",
      "type": "string"
    },
    "HandoffSummary": {
      "additionalProperties": false,
      "description": "Server-built handoff context persisted with a queue ticket.",
      "properties": {
        "actions_taken": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "additionalProperties": {
                  "$ref": "#/$defs/JsonValue"
                },
                "type": "object"
              }
            ]
          },
          "title": "Actions Taken",
          "type": "array"
        },
        "open_questions": {
          "items": {
            "$ref": "#/$defs/HandoffOpenQuestion"
          },
          "title": "Open Questions",
          "type": "array"
        },
        "verification_method": {
          "title": "Verification Method",
          "type": "string"
        },
        "verified_facts": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Verified Facts",
          "type": "object"
        }
      },
      "required": [
        "verified_facts",
        "actions_taken",
        "verification_method",
        "open_questions"
      ],
      "title": "HandoffSummary",
      "type": "object"
    },
    "JsonScalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonScalar"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        }
      ]
    },
    "Receipt": {
      "additionalProperties": false,
      "description": "Database-verified receipt returned on state-mutating actions.",
      "properties": {
        "action": {
          "description": "Action executed (e.g. card.block)",
          "maxLength": 64,
          "minLength": 3,
          "title": "Action",
          "type": "string"
        },
        "audit_id": {
          "description": "Cryptographic/audit reference ID",
          "maxLength": 128,
          "minLength": 8,
          "title": "Audit Id",
          "type": "string"
        },
        "state_after": {
          "$ref": "#/$defs/ResourceState",
          "description": "Resource state following action execution"
        },
        "state_before": {
          "$ref": "#/$defs/ResourceState",
          "description": "Resource state prior to action execution"
        },
        "target_masked": {
          "description": "Masked target identifier adhering to allowlist: masked PAN, email, phone, or opaque ref",
          "maxLength": 64,
          "minLength": 6,
          "pattern": "^((\\*{4}[\\s-]?\\*{4}[\\s-]?\\*{4}[\\s-]?\\d{4}|\\*{4,12}\\d{4})|[a-zA-Z0-9]\\*+@[a-zA-Z0-9.-]+\\.[a-zA-Z]{2,}|(\\+?\\d{1,3}[-\\s]?)?(\\d{1,4}[-\\s]?)?(\\*+[-\\s]?)+\\d{2,4}|(card|hnd|otp|chal|ticket|handoff)[_-][A-Za-z0-9*_-]{6,50})$",
          "title": "Target Masked",
          "type": "string"
        },
        "verified_at": {
          "description": "Timestamp of verified execution in database",
          "format": "date-time",
          "title": "Verified At",
          "type": "string"
        }
      },
      "required": [
        "action",
        "target_masked",
        "state_before",
        "state_after",
        "verified_at",
        "audit_id"
      ],
      "title": "Receipt",
      "type": "object"
    },
    "ReceiptBlock": {
      "additionalProperties": false,
      "description": "Verified receipt of a state-mutating action, re-read from the database.",
      "properties": {
        "receipt": {
          "$ref": "#/$defs/Receipt",
          "description": "Receipt returned by banking-core"
        },
        "type": {
          "const": "receipt",
          "default": "receipt",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "receipt"
      ],
      "title": "ReceiptBlock",
      "type": "object"
    },
    "ResourceState": {
      "description": "Resource state prior to and following execution of a state-mutating tool.",
      "enum": [
        "NONE",
        "ACTIVE",
        "BLOCKED",
        "FROZEN",
        "ISSUED",
        "PENDING",
        "VERIFIED",
        "EXPIRED",
        "LOCKED",
        "QUEUED",
        "ASSIGNED",
        "RESOLVED",
        "ANONYMOUS",
        "IDENTIFIED",
        "OTP_PENDING",
        "HANDED_OFF"
      ],
      "title": "ResourceState",
      "type": "string"
    },
    "TextBlock": {
      "additionalProperties": false,
      "description": "Plain assistant text.",
      "properties": {
        "text": {
          "description": "Assistant text shown to the customer",
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "type": {
          "const": "text",
          "default": "text",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "TextBlock",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "handoff": "#/$defs/HandoffBlock",
      "receipt": "#/$defs/ReceiptBlock",
      "text": "#/$defs/TextBlock"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/TextBlock"
    },
    {
      "$ref": "#/$defs/ReceiptBlock"
    },
    {
      "$ref": "#/$defs/HandoffBlock"
    }
  ]
}
