{
  "additionalProperties": false,
  "description": "Input contract for POST /v1/analyze.",
  "properties": {
    "decision_points": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Decision point ids to evaluate. null = every enabled, always-on decision point; an unknown id is a 422. [] evaluates none",
      "title": "Decision Points"
    },
    "lang": {
      "anyOf": [
        {
          "enum": [
            "es",
            "pt",
            "en"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional language code (es, pt, en)",
      "title": "Lang"
    },
    "text": {
      "description": "Customer input text to analyze",
      "maxLength": 2000,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "text"
  ],
  "title": "AnalyzeRequest",
  "type": "object"
}
