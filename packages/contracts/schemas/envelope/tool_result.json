{
  "$defs": {
    "FlowHint": {
      "additionalProperties": false,
      "description": "What banking-core allows after a call (ADR-0016). Advisory: every call is\nstill authorized, and nothing in the orchestrator decides on it.",
      "properties": {
        "allowed": {
          "description": "Every tool the effective configuration allows in `state`",
          "items": {
            "type": "string"
          },
          "title": "Allowed",
          "type": "array"
        },
        "next": {
          "description": "Tools that move the session forward from `state`",
          "items": {
            "type": "string"
          },
          "title": "Next",
          "type": "array"
        },
        "required_states": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/VerificationState"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "On a STATE_NOT_ALLOWED refusal: the states in which the tool runs",
          "title": "Required States"
        },
        "state": {
          "$ref": "#/$defs/VerificationState",
          "description": "Session state after the call"
        }
      },
      "required": [
        "state"
      ],
      "title": "FlowHint",
      "type": "object"
    },
    "ReasonCode": {
      "description": "Standard refusal and error reason codes.",
      "enum": [
        "STATE_NOT_ALLOWED",
        "POLICY_BLOCKED",
        "POLICY_FLAGGED",
        "RATE_LIMITED",
        "NOT_MATCHED",
        "NOT_IMPLEMENTED",
        "SESSION_BUSY",
        "INVALID_ARGUMENTS",
        "CODE_FLOOR_VIOLATION",
        "CONFIRMATION_REQUIRED",
        "INTERNAL_ERROR"
      ],
      "title": "ReasonCode",
      "type": "string"
    },
    "ToolResultStatus": {
      "description": "Execution status returned by banking-core.",
      "enum": [
        "ok",
        "refused",
        "error"
      ],
      "title": "ToolResultStatus",
      "type": "string"
    },
    "VerificationState": {
      "description": "Customer identity verification state in banking-core state machine.",
      "enum": [
        "ANONYMOUS",
        "IDENTIFIED",
        "OTP_PENDING",
        "VERIFIED",
        "LOCKED",
        "HANDED_OFF"
      ],
      "title": "VerificationState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Common envelope for results returned by banking-core.",
  "properties": {
    "data": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Payload returned by the tool when status is ok; None on refused/error",
      "title": "Data"
    },
    "flow": {
      "anyOf": [
        {
          "$ref": "#/$defs/FlowHint"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "What banking-core allows next (ADR-0016); advisory"
    },
    "reason_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReasonCode"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Standardized reason code when status is refused or error"
    },
    "status": {
      "$ref": "#/$defs/ToolResultStatus",
      "description": "Status of tool execution"
    },
    "tool": {
      "description": "Exact registered tool identifier (e.g. card.block)",
      "minLength": 1,
      "title": "Tool",
      "type": "string"
    }
  },
  "required": [
    "tool",
    "status"
  ],
  "title": "ToolResult",
  "type": "object"
}
