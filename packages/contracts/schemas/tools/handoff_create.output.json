{
  "$defs": {
    "Department": {
      "description": "Bank back-office specialized queues.",
      "enum": [
        "FRAUD_OPERATIONS",
        "CUSTOMER_SUPPORT",
        "DISPUTES"
      ],
      "title": "Department",
      "type": "string"
    },
    "HandoffOpenQuestion": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "source",
        "text"
      ],
      "title": "HandoffOpenQuestion",
      "type": "object"
    },
    "HandoffPriority": {
      "description": "Queue priority for agent assignment.",
      "enum": [
        "LOW",
        "NORMAL",
        "HIGH",
        "URGENT"
      ],
      "title": "HandoffPriority",
      "type": "string"
    },
    "HandoffStatus": {
      "description": "Status of handoff ticket.",
      "enum": [
        "QUEUED",
        "ASSIGNED",
        "PENDING"
      ],
      "title": "HandoffStatus",
      "type": "string"
    },
    "HandoffSummary": {
      "additionalProperties": false,
      "description": "Server-built handoff context persisted with a queue ticket.",
      "properties": {
        "actions_taken": {
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "additionalProperties": {
                  "$ref": "#/$defs/JsonValue"
                },
                "type": "object"
              }
            ]
          },
          "title": "Actions Taken",
          "type": "array"
        },
        "open_questions": {
          "items": {
            "$ref": "#/$defs/HandoffOpenQuestion"
          },
          "title": "Open Questions",
          "type": "array"
        },
        "verification_method": {
          "title": "Verification Method",
          "type": "string"
        },
        "verified_facts": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Verified Facts",
          "type": "object"
        }
      },
      "required": [
        "verified_facts",
        "actions_taken",
        "verification_method",
        "open_questions"
      ],
      "title": "HandoffSummary",
      "type": "object"
    },
    "JsonScalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonScalar"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        }
      ]
    },
    "Receipt": {
      "additionalProperties": false,
      "description": "Database-verified receipt returned on state-mutating actions.",
      "properties": {
        "action": {
          "description": "Action executed (e.g. card.block)",
          "maxLength": 64,
          "minLength": 3,
          "title": "Action",
          "type": "string"
        },
        "audit_id": {
          "description": "Cryptographic/audit reference ID",
          "maxLength": 128,
          "minLength": 8,
          "title": "Audit Id",
          "type": "string"
        },
        "state_after": {
          "$ref": "#/$defs/ResourceState",
          "description": "Resource state following action execution"
        },
        "state_before": {
          "$ref": "#/$defs/ResourceState",
          "description": "Resource state prior to action execution"
        },
        "target_masked": {
          "description": "Masked target identifier adhering to allowlist: masked PAN, email, phone, or opaque ref",
          "maxLength": 64,
          "minLength": 6,
          "pattern": "^((\\*{4}[\\s-]?\\*{4}[\\s-]?\\*{4}[\\s-]?\\d{4}|\\*{4,12}\\d{4})|[a-zA-Z0-9]\\*+@[a-zA-Z0-9.-]+\\.[a-zA-Z]{2,}|(\\+?\\d{1,3}[-\\s]?)?(\\d{1,4}[-\\s]?)?(\\*+[-\\s]?)+\\d{2,4}|(card|hnd|otp|chal|ticket|handoff)[_-][A-Za-z0-9*_-]{6,50})$",
          "title": "Target Masked",
          "type": "string"
        },
        "verified_at": {
          "description": "Timestamp of verified execution in database",
          "format": "date-time",
          "title": "Verified At",
          "type": "string"
        }
      },
      "required": [
        "action",
        "target_masked",
        "state_before",
        "state_after",
        "verified_at",
        "audit_id"
      ],
      "title": "Receipt",
      "type": "object"
    },
    "ResourceState": {
      "description": "Resource state prior to and following execution of a state-mutating tool.",
      "enum": [
        "NONE",
        "ACTIVE",
        "BLOCKED",
        "FROZEN",
        "ISSUED",
        "PENDING",
        "VERIFIED",
        "EXPIRED",
        "LOCKED",
        "QUEUED",
        "ASSIGNED",
        "RESOLVED",
        "ANONYMOUS",
        "IDENTIFIED",
        "OTP_PENDING",
        "HANDED_OFF"
      ],
      "title": "ResourceState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Outcome of human agent handoff creation.\n\nMutates queue state and returns a verified receipt referencing the handoff ticket.",
  "properties": {
    "created_at": {
      "description": "Timestamp of ticket creation",
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "department": {
      "$ref": "#/$defs/Department",
      "description": "Target department queue"
    },
    "handoff_id": {
      "description": "Unique handoff incident identifier",
      "maxLength": 64,
      "minLength": 8,
      "title": "Handoff Id",
      "type": "string"
    },
    "priority": {
      "$ref": "#/$defs/HandoffPriority",
      "description": "Effective priority assigned after banking-core policy"
    },
    "queue_position": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Estimated queue position if known",
      "title": "Queue Position"
    },
    "receipt": {
      "$ref": "#/$defs/Receipt",
      "description": "Verified receipt for handoff ticket creation"
    },
    "status": {
      "$ref": "#/$defs/HandoffStatus",
      "default": "QUEUED",
      "description": "Current ticket queue status"
    },
    "summary": {
      "$ref": "#/$defs/HandoffSummary",
      "description": "Server-built context stored with the handoff ticket"
    }
  },
  "required": [
    "handoff_id",
    "department",
    "priority",
    "summary",
    "created_at",
    "receipt"
  ],
  "title": "HandoffCreateOutput",
  "type": "object"
}
