{
  "$defs": {
    "AccountStatus": {
      "description": "Lifecycle status of an account.",
      "enum": [
        "ACTIVE",
        "FROZEN",
        "CLOSED"
      ],
      "title": "AccountStatus",
      "type": "string"
    },
    "AccountSummaryItem": {
      "additionalProperties": false,
      "description": "Account financial summary with minor currency units.",
      "properties": {
        "account_ref": {
          "description": "Opaque account reference token",
          "maxLength": 64,
          "minLength": 8,
          "title": "Account Ref",
          "type": "string"
        },
        "account_type": {
          "$ref": "#/$defs/AccountType",
          "description": "Type of banking account"
        },
        "available_balance_minor": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Available spendable balance in minor units, when requested",
          "title": "Available Balance Minor"
        },
        "currency": {
          "description": "ISO 4217 three-letter currency code",
          "maxLength": 3,
          "minLength": 3,
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "ledger_balance_minor": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Total ledger balance in minor units, when requested",
          "title": "Ledger Balance Minor"
        },
        "status": {
          "$ref": "#/$defs/AccountStatus",
          "description": "Current operational status of account"
        }
      },
      "required": [
        "account_ref",
        "account_type",
        "currency",
        "status"
      ],
      "title": "AccountSummaryItem",
      "type": "object"
    },
    "AccountType": {
      "description": "Type of deposit or credit account.",
      "enum": [
        "CHECKING",
        "SAVINGS",
        "CREDIT_LINE"
      ],
      "title": "AccountType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Account summaries for the pinned customer.",
  "properties": {
    "accounts": {
      "description": "Accounts belonging to the pinned session customer",
      "items": {
        "$ref": "#/$defs/AccountSummaryItem"
      },
      "title": "Accounts",
      "type": "array"
    }
  },
  "title": "AccountGetSummaryOutput",
  "type": "object"
}
