# ==============================================================================
# Example configuration. Copy to .env and adjust.
#
#   cp .env.example .env
#
# These values are for development and demo. NONE of them are production-ready:
# the cryptographic keys below are public by virtue of being here and must be
# regenerated before any real use.
# ==============================================================================

APP_ENV=development
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Language model
#
#   replay  prerecorded responses from eval/replay/. No key required.
#           Deterministic: reproduces the reported metrics exactly.
#   live    real calls to the provider. Requires LLM_API_KEY.
# ------------------------------------------------------------------------------
LLM_MODE=replay
LLM_API_KEY=
LLM_BASE_URL=TODO
# Model candidates: DeepSeek V4 Flash 0731 (default), DeepSeek V4.1 Flash, GPT 6 Luna
LLM_MODEL=TODO
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
# Reasoning models (e.g. GPT 6 Luna) reject temperature 0 unless reasoning is
# off: set "none". Blank = not sent, for models without reasoning.
LLM_REASONING_EFFORT=
# When a recording is missing in replay mode: fail (recommended) | passthrough
LLM_REPLAY_ON_MISS=fail
# Upper bound of tool-execution rounds the model may chain within one turn
MAX_TOOL_ROUNDS=5
# Eval-only chat response details; forbidden when APP_ENV=production.
EVAL_EXPOSE_TURN=false
# Decision points (ADR-0012). The effects file binds each decision point to an engine
# effect and a mode (off | shadow | enforce); blank = the file shipped with the
# orchestrator, apps/orchestrator/config/decision_effects.yaml, every decision point in
# shadow. DECISION_POINTS_MODES overrides modes without touching code, the kill switch
# of docs/runbook.md: 'confirm_gate=shadow,block_reason=off'. An invalid file or a
# malformed override stops the orchestrator at startup.
DECISION_EFFECTS_FILE=
DECISION_POINTS_MODES=

# ------------------------------------------------------------------------------
# Model server: the encoder service (local, CPU). It serves the decision model
# (/v1/analyze) and the embedding model of kb.search (/v1/embed), and receives raw
# customer text, so it runs only inside the team's private network, on this host or
# on its own (ADR-0012, Appendix J). To move it, point ENCODER_URL and
# MODEL_SERVER_URL at it.
# ------------------------------------------------------------------------------
ENCODER_URL=http://encoder:8090
# The orchestrator treats the encoder as optional: on 503 or timeout the turn
# continues LLM-only and records encoder_unavailable in the turn metadata.
ENCODER_ENABLED=true
ENCODER_TIMEOUT_SECONDS=2
# Inference backend: tfidf_lr (lexical baseline, trained at startup on the
# versioned synthetic train split) | gliner (needs the image built with
# ENCODER_EXTRAS=gliner, ENCODER_MODEL and `make warmup`). Empty = no model:
# /ready and /v1/analyze return 503.
ENCODER_BACKEND=tfidf_lr
# gliner only: Hugging Face model id or a local directory with the weights.
ENCODER_MODEL=
# Build argument, space or comma separated. `embed` adds PyTorch and
# sentence-transformers for /v1/embed (the kb.search embedding model); `gliner` adds
# PyTorch for ENCODER_BACKEND=gliner; `hf` adds transformers for the fine-tuned
# DistilBERT decision backend (hf_seqcls, ADR-0014). Empty builds the decision
# baseline only, and then EMBEDDING_MODEL below must be empty too and
# DECISION_POINTS_FILE must name the tfidf_lr artifact: a model that is configured
# but cannot be loaded stops the service.
ENCODER_EXTRAS=embed hf
# Threads per inference (a fixed count keeps decisions reproducible, ADR-0012 E.4).
ENCODER_THREADS=2
# CPU only (ADR-0008); any other value fails at startup.
ENCODER_DEVICE=cpu
# Container memory limit. 3g should fit tfidf_lr plus the embedding model (estimate,
# Linux figure pending); ENCODER_BACKEND=gliner (~3.5 GB alone) needs 5g with it.
ENCODER_MEMORY_LIMIT=3g
# gliner refuses to start when the cgroup memory limit is below this (MiB).
ENCODER_GLINER_MIN_MEMORY_MB=4096
ENCODER_QUANTIZED=true
# Decision points (ADR-0012). The calibration artifact is written by the harness
# (`make calibrate TASK=decision-points`) and read at startup; a seed artifact is
# committed at packages/encoder/calibration/decision_points.json (provisional
# evidence, nothing certified: reports/calibration-decision-points-2026-09-29.md).
# While it is there the thresholds come from it and ABSTENTION_THRESHOLD below is
# ignored. Legacy seed mode (ABSTENTION_THRESHOLD as a one-DP uncalibrated
# turn_intent) only happens when no artifact file exists.
# Path of the artifact. The default is the pooled DistilBERT one (ADR-0014; its
# weights ship in the encoder image, reports/calibration-decision-points-2026-09-30-
# distilbert.md). Kill switch back to the lexical baseline:
# DECISION_POINTS_FILE=packages/encoder/calibration/decision_points.json.
# A path that does not exist means "no artifact", except under APP_ENV=production.
DECISION_POINTS_FILE=packages/encoder/calibration/decision_points.distilbert.json
# Downgrade a backend whose model does not match its pin to "unavailable" instead
# of stopping the service. Refused when APP_ENV=production.
DECISION_POINTS_ALLOW_STALE=false
# Raise-only tau override, e.g. confirm_gate.es=0.97,turn_intent.*=0.9. It can make
# a decision point more conservative, never less; anything else stops the service.
DECISION_POINTS_TAU_RAISE=
# Abstention threshold: the LEGACY SEED, used only when no calibration artifact
# exists. With the committed artifact the encoder ignores it: the artifact's
# per-language thresholds win, and startup logs "ABSTENTION_THRESHOLD is set but a
# calibration artifact exists: the artifact's thresholds win; the environment value
# is ignored". If set it must still be a number in [0, 1]. To be more conservative
# use DECISION_POINTS_TAU_RAISE; to change a threshold, recalibrate.
# Calibrated on validation, NEVER on the test split. See docs/evaluation.md
# Without an artifact, empty = uncalibrated mode: the encoder starts, but /ready
# and /v1/analyze return 503 until this is set from a `make calibrate TASK=decision`
# report. With the artifact, empty is fine.
# 0.37 = the highest per-language tau of tfidf_lr in
# reports/calibration-decision-2026-09-28.md (es 0.366, pt 0.338, en 0.149).
ABSTENTION_THRESHOLD=0.37

# ------------------------------------------------------------------------------
# Knowledge retrieval
# ------------------------------------------------------------------------------
# kb.search runs in banking-core (ADR-0002: the KB is config). Vector is the
# default (ADR-0006 amendment); bm25 or hybrid only when set explicitly. The
# embedding model runs on the model server (ADR-0012, Appendix J): banking-core
# builds the ~120-snippet index in memory from vectors that /v1/embed returned and
# embeds each query there. The model is pinned; the same EMBEDDING_MODEL and
# EMBEDDING_REVISION configure both services, and banking-core refuses any answer
# from another model or revision (kb.search is then unavailable, never a fallback).
# The model is read from the hf-cache volume of the model server only: run
# `make warmup-retrieval` once (network); it prints the hash to pin.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# A full 40-hex commit (a branch is not a pin). Confirm it with `make warmup-retrieval`.
EMBEDDING_REVISION=86741b4e3f5cb7765a600d3a3d55a0f6a6cb443d
# Optional, recommended: SHA-256 of the weights file (model.safetensors), verified at
# startup. `make warmup-retrieval` prints it.
EMBEDDING_WEIGHTS_SHA256=eaa086f0ffee582aeb45b36e34cdd1fe2d6de2bef61f8a559a1bbc9bd955917b
# Texts per /v1/embed request (contract ceiling 256).
EMBEDDING_MAX_BATCH=64
# remote = the model server (default). local = the model in the banking-core process,
# for tests and local development only: needs the image built with the vector extra,
# BANKING_CORE_MEMORY_LIMIT=2g and the model in the local Hugging Face cache.
EMBEDDING_BACKEND=remote
MODEL_SERVER_URL=http://encoder:8090
MODEL_SERVER_TIMEOUT_SECONDS=10
RETRIEVAL_MODE=vector          # vector | bm25 | hybrid
RETRIEVAL_TOP_K=5              # cap on results per query (contract max 20)
RETRIEVAL_SCORE_FLOOR=0.3      # uncalibrated seed; below it, same-language falls back to cross-language
RETRIEVAL_HYBRID_ALPHA=0.5     # 0 = lexical only, 1 = vector only
# Image extras: `--extra vector` is needed only by EMBEDDING_BACKEND=local; "" builds
# a smaller banking-core image without torch (untested in a container so far).
BANKING_CORE_SYNC_ARGS=--extra vector
# The embedding model (~1.3 GB RSS with the KB index, measured on macOS) no longer
# loads in banking-core by default, so this ceiling can be lowered once measured on
# Linux. EMBEDDING_BACKEND=local needs 2g.
BANKING_CORE_MEMORY_LIMIT=2g

# ------------------------------------------------------------------------------
# Database
# Only banking-core receives database credentials. orchestrator does not.
# See docs/adr/0004-trust-boundary.md
# ------------------------------------------------------------------------------
BANKING_CORE_URL=http://banking-core:8081
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=bank
POSTGRES_USER=app
POSTGRES_PASSWORD=dev-only-change-me
# Blank keeps the bundled development database; production host mode requires it.
# Example only; replace the placeholder and keep host Postgres reachable from Docker:
# DATABASE_URL=postgresql+psycopg://app:replace-me@host.docker.internal:5432/bank
DATABASE_URL=

# Redis URLs override host/port/password. Blank keeps each bundled dev Redis.
# Use redis:// or rediss://; URL-encode reserved characters in credentials.
# Examples only; replace placeholders. The users are ACL identities, not secrets.
# REDIS_CORE_URL=rediss://core-svc:replace-me@host.docker.internal:6379/0
# REDIS_EDGE_URL=rediss://edge-svc:replace-me@host.docker.internal:6379/0
REDIS_CORE_URL=
REDIS_EDGE_URL=
# Exact default key prefixes: banking-core writes session:, otp:challenge:,
# otp:inbox: (the simulated OTP inbox) and limit: (cross-session attempt
# limits); orchestrator writes orch:conv:, orch:ratelimit: (per-IP conversation
# counters, keyed hashes, no addresses) and orch:session: (banking session id ->
# conversation id, for the agent API; expires with the conversation).
# ACL patterns: core ~session:* ~otp:* ~limit:*; edge ~orch:*. Keep ACL patterns
# aligned if prefixes change (docs/deployment.md has the exact ACL SETUSER lines).
REDIS_SESSION_KEY_PREFIX=session:
REDIS_OTP_CHALLENGE_KEY_PREFIX=otp:challenge:
REDIS_OTP_INBOX_KEY_PREFIX=otp:inbox:
REDIS_ATTEMPT_LIMIT_KEY_PREFIX=limit:
REDIS_EDGE_KEY_PREFIX=orch:conv:
REDIS_EDGE_RATE_LIMIT_KEY_PREFIX=orch:ratelimit:
REDIS_EDGE_SESSION_INDEX_KEY_PREFIX=orch:session:
# Optional production bundled data: enable --profile bundled-data and point the
# URLs at postgres / redis-core / redis-edge instead of host.docker.internal.
# Start bundled services and wait for readiness before launching the app stack:
# docker compose --profile bundled-data -f infra/compose/docker-compose.yml -f infra/compose/docker-compose.prod.yml up -d --wait postgres redis-core redis-edge
# After setting DATABASE_URL, Redis URLs, REGISTRY, and IMAGE_TAG, verify that
# orchestrator receives neither database nor core Redis credentials:
# docker compose --profile bundled-data -f infra/compose/docker-compose.yml -f infra/compose/docker-compose.prod.yml config --format json | python -c 'import json, sys; env = json.load(sys.stdin)["services"]["orchestrator"]["environment"]; assert not {"DATABASE_URL", "REDIS_CORE_URL"} & env.keys()'

# ------------------------------------------------------------------------------
# Dataset ingest (make ingest SOURCE=factored), see docs/adr/0011-hybrid-seed-dataset-ingest.md
# ------------------------------------------------------------------------------
INGEST_MAX_CUSTOMERS=5000   # 0 = full volume (slower seed)
INGEST_ANCHOR_DATE=         # YYYY-MM-DD; empty = run date. Dataset history is shifted to end here

# ------------------------------------------------------------------------------
# Cryptography and secrets
#
# REGENERATE BEFORE ANY REAL USE:
#   openssl rand -base64 32
#
# Production host-data mode uses DATABASE_URL and the Redis URLs above.
# These passwords are for development or optional bundled production data;
# generate with `openssl rand -hex 32` (avoid `$` to prevent Compose interpolation).
#
# In production the master key belongs in a KMS or HSM, not in the environment.
# See docs/adr/0005-application-level-encryption.md
# ------------------------------------------------------------------------------
MASTER_KEY=dev-only-regenerate-this-key
BLIND_INDEX_SALT=dev-only-regenerate-this-salt
SESSION_SECRET=dev-only-regenerate-this-secret
# HMAC key of the back office's session cookie (apps/web-backoffice). The server
# refuses to start with this value under APP_ENV=production.
BACKOFFICE_SESSION_SECRET=dev-only-backoffice-session-secret
REDIS_CORE_PASSWORD=dev-only-regenerate-core-redis   # redis-core: banking-core only
REDIS_EDGE_PASSWORD=dev-only-regenerate-edge-redis   # redis-edge: orchestrator only
# Session TTL: idle TTL of the conversation on redis-edge (orchestrator) and the
# seed of banking-core's session TTL policy. The single-turn lock TTL is
# derived: LLM_TIMEOUT_SECONDS x (1 + LLM_MAX_RETRIES) x (MAX_TOOL_ROUNDS + 1)
# plus this margin; saves are also fenced on the lock token.
SESSION_TTL_SECONDS=3600
SESSION_LOCK_MARGIN_SECONDS=60

# ------------------------------------------------------------------------------
# Customer verification
#
# The OTP is never sent by email, SMS or any other external channel (ADR-0007,
# amendment 2026-09-29). banking-core drops the code in an in-app inbox on
# redis-core and the web client shows a "you got an email with the code" notice.
# OTP_CHANNEL_MODE picks the delivery implementation. Only `simulated` is
# implemented: any other value stops banking-core at startup ("no real OTP
# delivery provider is implemented; set OTP_CHANNEL_MODE=simulated"). A real
# provider would plug in behind the same port. Whoever sees the browser sees the
# code, so in the demo the OTP does not prove possession of the registered channel.
# The model never sees the code and never chooses the channel.
# Document verification uses a simulated provider: see ADR-0007.
# ------------------------------------------------------------------------------
OTP_CHANNEL_MODE=simulated
# Seconds a code stays valid, and how long its inbox entry lives: 30..900, the
# bounds of the otp.send contract. A value outside them is rejected when the
# policy config loads.
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_MAX_RESENDS=3
# Expose the dev OTP retrieval endpoint only in local evaluation. It returns
# codes in clear: banking-core refuses to start with this true when
# APP_ENV=production.
ALLOW_DEV_OTP_HOOK=false

# ------------------------------------------------------------------------------
# Policies and guardrails
#
# These are only the initial SEED. The live configuration lives in the database
# and is edited from the back office without deploying.
# See docs/adr/0002-config-code-boundary.md
# ------------------------------------------------------------------------------
DEFAULT_CURRENCY=COP
# Risk thresholds in minor currency units (e.g. 50000 cents = $500 USD)
# Seed defaults align with KB "500 currency units" (~USD 500 equivalents):
# USD 50000 ($500), EUR 50000 (€500), BRL 250000 (R$ 2,500), COP 200000000 ($2,000,000)
# ARS 17795642 (ARS 177,956.42): USD 500 at the last USD→ARS rate before the
# Factored dataset cutoff (355.912847, 2026-06-17); computation printed by
# `make ingest SOURCE=factored` in reports/data-quality-factored.md
POLICY_SEED_THRESHOLDS_MINOR='{"USD": 50000, "EUR": 50000, "BRL": 250000, "COP": 200000000, "ARS": 17795642}'
POLICY_SEED_AMOUNT_MODE=flag             # flag = handoff recommended | block = handoff required (above the threshold; the card block itself is never refused)
# Tools that start DISABLED (comma separated; empty = none). A disabled tool is
# permitted in no state until an operator enables it, live and audited, with
# PUT /v1/admin/tool-policy (needs ADMIN_API_ENABLED). account.get_summary is the
# second workflow's tool. The seed can only disable: it never widens a tool beyond
# the code floor, and the demo reset returns the tool policy to it.
POLICY_SEED_DISABLED_TOOLS=account.get_summary
# Write tools always require VERIFIED; this is a code floor, not configuration (ADR-0003 Appendix A).
RATE_LIMIT_ATTEMPTS_PER_SESSION=5
# Cross-session limits (banking-core): the per-session counters above start over
# with every new session, these do not. Seeds for config.policy_config. Windows
# and locks are 60..604800 seconds; a window opens with its first failure.
# Failed otp.verify per customer: at MAX_FAILURES within WINDOW the customer is
# locked for LOCK_SECONDS (no new code, no verification; the chat goes to a human).
RATE_LIMIT_CUSTOMER_OTP_MAX_FAILURES=5
RATE_LIMIT_CUSTOMER_OTP_WINDOW_SECONDS=3600
RATE_LIMIT_CUSTOMER_OTP_LOCK_SECONDS=1800
# Failed customer.match per claimed document, whether or not it exists: past
# MAX_FAILURES within WINDOW, matches answer matched=false without checking.
RATE_LIMIT_DOCUMENT_MATCH_MAX_FAILURES=10
RATE_LIMIT_DOCUMENT_MATCH_WINDOW_SECONDS=3600
# Conversations one client address may open per hour, read by the orchestrator
# (fixed one-hour window on redis-edge): POST /v1/conversations past this answers
# 429 with Retry-After and opens no banking session.
#   1000  the development compose default, kept here: a local session or an
#         evaluation run (one conversation per scenario, 53 from one address)
#         must not hit the limit.
#   30    the value for a public presentation environment. docker-compose.prod.yml
#         and deploy.yml use it unless told otherwise.
# It must be at least 1: 0 is not "unlimited", the orchestrator refuses to start.
RATE_LIMIT_CONVERSATIONS_PER_IP_HOUR=1000
# Reverse proxies in front of the orchestrator. 0 ignores X-Forwarded-For: the
# client address is the connection peer. Behind N proxies that each append the
# address they saw, set N; left at 0 every customer shares the proxy's address
# and budget. Never set more than the real number: the extra entries come from
# the client.
#   1  the compose default, kept here: the customer path is the web-client BFF,
#      which sends the address of its own connection as X-Forwarded-For. The
#      orchestrator's port is published on 127.0.0.1 only, so a forged header can
#      come only from the host itself.
#   0  the orchestrator's own default, for running it with no proxy in front.
TRUSTED_PROXY_HOPS=1
# Per-session lock serializing tool calls in banking-core (a waiter past WAIT gets SESSION_BUSY)
SESSION_LOCK_TTL_MS=10000
SESSION_LOCK_WAIT_MS=2000
# Operator-only banking-core API (policy config, demo fixture reset). These are
# the development values, the same as the compose defaults: on, with a public
# development-only token, so the back office demo steps work locally. banking-core
# refuses to start with this token, or an empty one, under APP_ENV=production: a
# presentation environment sets a secret of its own (docs/deployment.md,
# "Presentation environment").
ADMIN_API_ENABLED=true
ADMIN_API_TOKEN=dev-only-admin-token
# Only consulted when APP_ENV=production; outside it the fixture reset is always
# allowed.
DEMO_RESET_ENABLED=false
# Agent API of the orchestrator (/v1/agent): the back office reads a conversation's
# masked transcript and takes it over from the assistant. The back office server
# (apps/web-backoffice) holds this token and ADMIN_API_TOKEN above, under the same
# names, so the two sides always agree. These are the development values, the same
# as the compose defaults: on, with a public development-only token. Off by default
# in the orchestrator itself. The orchestrator refuses to start with this token, or
# an empty one, under APP_ENV=production: a presentation environment sets a secret
# of its own (docs/deployment.md, "Presentation environment").
AGENT_API_ENABLED=true
AGENT_API_TOKEN=dev-only-agent-token
# How long a takeover or an agent message waits for a customer turn in flight
# before answering 503 (the caller retries). Seconds, 0 to 120.
AGENT_LOCK_WAIT_SECONDS=10
# Cap recent transaction pages; the contract hard limit is 50.
TRANSACTION_LIST_MAX_LIMIT=50

# ------------------------------------------------------------------------------
# Languages
# Internal system instructions are in English; customers are served in theirs.
# ------------------------------------------------------------------------------
SUPPORTED_LOCALES=es,pt,en
DEFAULT_LOCALE=es

# ------------------------------------------------------------------------------
# Observability
# ------------------------------------------------------------------------------
TRACE_ENABLED=true
COST_TRACKING_ENABLED=true
AUDIT_HASH_CHAIN_ENABLED=true

# ------------------------------------------------------------------------------
# Ports (change if they are taken on your machine)
# To run several copies at once, also set a distinct COMPOSE_PROJECT_NAME per copy
# (default: pattern-blue). See docs/runbook.md, "Running several copies".
# ------------------------------------------------------------------------------
PORT_WEB_CLIENT=5173
PORT_WEB_BACKOFFICE=5174
PORT_ORCHESTRATOR=8080
PORT_BANKING_CORE=8081
PORT_ENCODER=8090

# ------------------------------------------------------------------------------
# Demo credentials (test environment, non-production data)
# ------------------------------------------------------------------------------
# The one agent login of the back office (http://localhost:5174). The email is also
# the agent_ref of every claim, takeover and audit row. The back office refuses to
# start with the development password under APP_ENV=production.
DEMO_AGENT_EMAIL=agent@demo.local
DEMO_AGENT_PASSWORD=demo-only-change-me
DEMO_CUSTOMER_DOCUMENT_ES=1020304050
DEMO_CUSTOMER_DOCUMENT_PT=12345678900
DEMO_CUSTOMER_DOCUMENT_EN=P12345678

